# Backend contact form (backend/server.js) — copy to backend/.env and fill in.
# Never commit the real .env (already gitignored).

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8080,https://adelineguillotgueret.fr

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@example.com
SMTP_PASS=your-app-password

# Mail routing
CONTACT_EMAIL=contact@adelinegueret.fr
SEND_CONFIRMATION=false

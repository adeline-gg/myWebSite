# direnv + pass — GitHub Terraform credentials for adeline-gg/myWebSite (never on disk).
# Requires the pass entry (owner-scoped Terraform PAT with repo + admin scopes):
#   pass show github/terraform-token-addeline-gg
#
# After editing this file, run:  direnv allow
export TF_VAR_github_token=$(pass github/terraform-token-addeline-gg)
